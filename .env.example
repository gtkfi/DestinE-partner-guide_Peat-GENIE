# Copy to .env in the repository root. Fill only variables needed by your tutorial.
# Never commit .env, tokens, signed links, or credential files.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Paste credential-free URLs from the CURRENT EDH catalogue; API key lives in netrc.
EDH_ERA5_URL=
EDH_DEM_URL=
EDH_TP_CONVENTION=accumulated_m

# Paths are relative to the repository root or absolute paths on YOUR computer.
INPUT_B04=
INPUT_B08=
INPUT_SCL=
INPUT_L2A_METADATA=
S2_CALIBRATION=native_dn
S2_HARMONIZED_QUANTIFICATION=10000
S2_AOI_BBOX=[24.55,60.15,24.57,60.17]

INPUT_NUPSI=
NUPSI_NDVI_BAND=1
INPUT_EDEN_PRECIP=
EDEN_PRECIP_CONVENTION=monthly_mean_daily_m
EDEN_YEAR=2025
EDEN_MONTH=10

# HDA: select an explicit asset after inspecting metadata.
# Add exact trusted provider hostnames only after reviewing the asset delivery route.
HDA_ASSET_KEY=
HDA_ALLOWED_ASSET_HOSTS=
HDA_DOWNLOAD=false
HDA_PLACE_ORDER=false

POLYTOPE_ADDRESS=polytope.lumi.apps.dte.destination-earth.eu
POLYTOPE_RATE_TIME_DIM=steps
POLYTOPE_INTERVAL_SECONDS=3600
